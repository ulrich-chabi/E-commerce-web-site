# Copier ce fichier en ".env" (ne jamais committer ".env").

# --- Base de données (obligatoire) ---
# Local : adapter l'utilisateur, le mot de passe et le nom de la base.
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/marketplace
# Mettre true si l'hébergeur PostgreSQL impose SSL.
DATABASE_SSL=false

# --- Origines autorisées (CORS) ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# --- Secrets (OBLIGATOIRES en production, valeurs longues et aléatoires) ---
JWT_SECRET=
COOKIE_SECRET=

# --- Optionnel : à renseigner selon l'hébergeur ---
# URL publique du backend (utile derrière un proxy ou en ligne).
MEDUSA_BACKEND_URL=
# Redis (laisser vide en local).
REDIS_URL=
# shared | server | worker (laisser vide en local).
MEDUSA_WORKER_MODE=
# true pour ne pas servir le tableau de bord d'administration.
DISABLE_MEDUSA_ADMIN=false

# --- Sécurité (valeurs par défaut du prototype, à durcir avant tout usage réel) ---
# Longueur minimale d'un mot de passe (4 pour le prototype ; 12 recommandé en usage réel).
PASSWORD_MIN_LENGTH=4
# Échecs de connexion tolérés avant blocage, et durée du blocage en minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Délai (en jours) après lequel l'email et l'IP du journal d'audit sont effacés.
PERSONAL_DATA_RETENTION_DAYS=90
